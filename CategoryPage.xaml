<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShirleyBas_GuessTheWordGame.CategoryPage"
             Title="CategoryPage">

    <Grid>
        <Image
              Source="background.png"
              Aspect="AspectFill" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label
                Text="Choose a category"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                FontFamily="poppins"
                TextColor="White"
                Margin="0,85,0,0"/>


            <ImageButton Grid.Row="1"
                         x:Name="program"
                         Clicked="program_Clicked"
                         Source="programi.png"
                         WidthRequest="300"
                         CornerRadius="20"
                         BackgroundColor="Transparent"
                         Margin="0,50,0,0"
                         />

            <ImageButton Grid.Row="2"
                         x:Name="animal"
                         Clicked="animal_Clicked"
                         Source="animals.png"
                         WidthRequest="150"
                         CornerRadius="20"
                         BackgroundColor="Transparent"
                         Margin="0,30,0,0"
                         />




        </Grid>
    </Grid>


</ContentPage>
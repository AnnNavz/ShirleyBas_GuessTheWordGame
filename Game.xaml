<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShirleyBas_GuessTheWordGame.Game"
             Title="Game">

    <Grid>
        <Image
           Source="game_background.png"
           Aspect="AspectFill" />

        <Grid
            RowDefinitions=".6*,.4*, Auto">
            <VerticalStackLayout Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                
                <Label FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Text="{Binding GameStatus}"
                       FontFamily="poppins"
                       FontSize="16"
                       Margin="0,10,0,0"
                       />

                <Image HeightRequest="200"/>

                <Label FontSize="40"
                       HorizontalOptions="Center"
                       Text="{Binding Spotlight}"
                       VerticalOptions="Center"/>

                <Label FontSize="Large"
                       HorizontalTextAlignment="Center"
                       Text="{Binding Message}"/>

            </VerticalStackLayout>
            <FlexLayout x:Name="LettersContainer"
                        Grid.Row="1"
                        Wrap="Wrap"
                        JustifyContent="SpaceEvenly"
                        BindableLayout.ItemsSource="{Binding Letters}"
                        Margin="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button HeightRequest="25"
                                WidthRequest="50"
                                FontFamily="poppins"
                                Text="{Binding .}"
                                x:Name="letter"
                                FontAttributes="Bold"
                                TextColor="Black"
                                FontSize="23"
                                BackgroundColor="White"
                                Clicked="letter_Clicked"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Button     HorizontalOptions="Center"
                        x:Name="Reset"
                        Clicked="Reset_Clicked"
                        Text="Reset"
                        WidthRequest="150"
                        HeightRequest="20"
                        FontFamily="poppins"
                        FontAttributes="Bold"
                        FontSize="18"
                        BackgroundColor="#C295ED"
                        Grid.Row="2"
                        Margin="0,0,0,30"/>


        </Grid>
        
        
    </Grid>
</ContentPage>